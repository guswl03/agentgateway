  "cards": [
    {
      "law_id": "KR_AI_BASIC_ACT",
      "policy_id": "KR_AI_GATEWAY_TEXT_MARK_002",
      "policy_text": "관리자가 지정한 비스트리밍 JSON 응답 경로와 텍스트 필드에 AI 생성 사실을 나타내는 고정 안내 문구를 Gateway 응답 본문 변환으로 삽입한다. 적용 경로·필드·문구는 설정값으로 고정하며 도구 호출 인자나 구조화 업무 데이터는 변환 대상에 포함하지 않는다. 이 카드는 통신 데이터의 문구 삽입이라는 기술적 기여만 제공하며 이용자 인식과 법정 표시 의무 전체의 충족을 판정하지 않는다.",
      "function": [
        {
          "function_id": "AGW-BODY-HEADER-TRANSFORM-RESPONSE",
          "action": "rewrite_body",
          "object": "AI_OUTPUT"
        }
      ],
